from flask import Flask, request, jsonify
from flask_cors import CORS
import json
import os

app = Flask(__name__)
CORS(app)

# Load career database
CAREER_DATABASE_FILE = 'career_database.json'

def load_career_database():
    if os.path.exists(CAREER_DATABASE_FILE):
        with open(CAREER_DATABASE_FILE, 'r', encoding='utf-8') as f:  # Added encoding='utf-8'
            return json.load(f)
    return {}

CAREER_DATABASE = load_career_database()

@app.route('/health', methods=['GET'])
def health():
    return jsonify({
        'status': 'healthy',
        'total_careers': len(CAREER_DATABASE)
    })

@app.route('/api/recommend', methods=['POST'])
def recommend():
    try:
        user_data = request.json
        
        # Extract user data
        skills = [s.lower() for s in user_data.get('skills', [])]
        interests = [i.lower() for i in user_data.get('interests', [])]
        goals = user_data.get('career_goals', '').lower()
        field = user_data.get('field_of_study', '').lower()
        
        # Score each career
        career_scores = []
        
        for career_name, career in CAREER_DATABASE.items():
            score = 0
            
            # Match skills (highest weight)
            for req_skill in career['required_skills']:
                if any(req_skill.lower() in skill for skill in skills):
                    score += 10
            
            # Match interests
            for keyword in career['keywords']:
                if any(keyword in interest for interest in interests):
                    score += 8
            
            # Match goals
            for keyword in career['keywords']:
                if keyword in goals:
                    score += 5
            
            # Match field of study
            if field and any(keyword in field for keyword in career['keywords']):
                score += 6
            
            # Calculate current skills
            current_skills = [
                skill for skill in career['required_skills']
                if any(skill.lower() in s for s in skills)
            ]
            
            # Calculate skill gap
            skill_gap = [
                skill for skill in career['required_skills']
                if skill not in current_skills
            ][:5]
            
            match_score = min(95, max(70, 70 + (score / 2)))
            
            career_scores.append({
                'title': career_name,
                'description': career['description'],
                'matchScore': round(match_score),
                'reason': f"Based on your {', '.join(skills[:2]) if skills else 'profile'}, you're well-suited for this role",
                'requiredSkills': career['required_skills'],
                'currentSkills': current_skills,
                'skillGap': skill_gap,
                'icon': career.get('icon', '💼')
            })
        
        # Sort by score
        career_scores.sort(key=lambda x: x['matchScore'], reverse=True)
        
        return jsonify({
            'success': True,
            'recommendations': career_scores[:5]
        })
        
    except Exception as e:
        print(f"Error in recommendation: {str(e)}")
        return jsonify({'error': str(e)}), 500

if __name__ == '__main__':
    print(f"✅ ML Service starting...")
    print(f"📊 Loaded {len(CAREER_DATABASE)} careers")
    app.run(host='0.0.0.0', port=5001, debug=True)
